rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública.
    // Las modificaciones no se permiten desde el frontend.
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }

    // Compras
    match /compras/{compraId} {

      // Cada usuario autenticado puede leer únicamente sus propias compras.
      allow read: if request.auth != null
                  && resource.data.usuarioUid == request.auth.uid;

      // Las compras ahora se crean y modifican exclusivamente
      // desde el backend mediante Firebase Admin.
      allow create, update, delete: if false;
    }
  }
}